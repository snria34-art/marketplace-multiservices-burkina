    {
      "source": "/real-estate",
      "destination": "/index.html"
    },
    {
      "source": "/accommodations",
      "destination": "/index.html"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/index.html"
    },
    {
      "source": "/professionals",
      "destination": "/index.html"
    },
    {
      "source": "/agriculture",
      "destination": "/index.html"
    },
    {
      "source": "/freight",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/index.html"
    },
    {
      "source": "/beauty",
      "destination": "/index.html"
    },
    {
      "source": "/home-services",
      "destination": "/index.html"
    },
    {
      "source": "/digital",
      "destination": "/index.html"
