{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Dart and Flutter dependencies are installed by scripts/vercel-build.sh'",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/recovery",
      "destination": "/index.html"
    },
    {
      "source": "/access-status",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/orders/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/delivery/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/courier",
      "destination": "/index.html"
    },
    {
      "source": "/restaurants",
      "destination": "/index.html"
    },
    {
      "source": "/transport",
      "destination": "/index.html"
    },
    {
      "source": "/mechanics",
      "destination": "/index.html"
    },
    {
      "source": "/expiry",
      "destination": "/index.html"
    },
    {
      "source": "/follows",
      "destination": "/index.html"
    },
    {
      "source": "/group-buy",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/messages",
      "destination": "/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/index.html"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/seller",
      "destination": "/index.html"
    },
    {
      "source": "/seller/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/promotions",
      "destination": "/index.html"
    },
    {
      "source": "/rides",
